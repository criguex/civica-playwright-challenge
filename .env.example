# Copy to `.env` and adjust as needed. All values are optional.

# Base URL under test. Defaults to the live IMDb site.
# The mock project intercepts requests to this origin, so it works either way.
BASE_URL=https://www.imdb.com

# Jev credentials for the semantic oracle and the failure-triage reporter.
# Either one works; TYPESAFE_API_KEY wins if both are set. Without either,
# both degrade to a clearly-labelled offline stub, so the suite stays runnable
# on a fresh clone.

# Direct — https://console.typesafe.ai
TYPESAFE_API_KEY=

# Vercel AI Gateway — https://vercel.com/ai-gateway
# Same model, same $0.042/1M price, no TypeSafe account needed. Use this when
# TypeSafe has paused its own signups. The team needs a card on file or calls
# fail with customer_verification_required.
AI_GATEWAY_API_KEY=
