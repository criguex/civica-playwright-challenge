# Copy to `.env` and adjust as needed. All values are optional.

# Base URL under test. Defaults to the live IMDb site.
# The mock project intercepts requests to this origin, so it works either way.
BASE_URL=https://www.imdb.com

# TypeSafe AI key, used by the semantic oracle and the failure-triage reporter.
# Get one at https://console.typesafe.ai — without it both degrade to a
# clearly-labelled offline stub, so the suite stays runnable on a fresh clone.
TYPESAFE_API_KEY=
