{
  "name": "civica-playwright-challenge",
  "version": "1.1.0",
  "description": "Test automation framework (Playwright + TypeScript, Page Object Model) covering two IMDb user flows, with a deterministic mock layer, accessibility checks and a learning mutant-scenario engine.",
  "author": "Cristian Guerra (@criguex)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test --project=mock",
    "test:mock": "playwright test --project=mock",
    "test:mutation": "playwright test --project=mutation",
    "test:a11y": "playwright test --project=mock --grep @a11y",
    "test:e2e": "playwright test --project=e2e",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=mock --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "PWDEBUG=1 playwright test --project=mock",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.imdb.com",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "typescript",
    "page-object-model",
    "test-automation",
    "qa",
    "imdb",
    "e2e",
    "accessibility",
    "mutation-testing"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.12.0",
    "eslint-plugin-playwright": "^2.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}
