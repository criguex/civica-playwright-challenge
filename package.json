{
  "name": "civica-playwright-challenge",
  "version": "1.0.0",
  "description": "Test automation framework (Playwright + TypeScript, Page Object Model) covering two IMDb user flows, with a deterministic mock layer as fallback.",
  "author": "Cristian Guerra (@criguex)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test --project=mock",
    "test:mock": "playwright test --project=mock",
    "test:e2e": "playwright test --project=e2e",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=mock --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "PWDEBUG=1 playwright test --project=mock",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.imdb.com",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "typescript",
    "page-object-model",
    "test-automation",
    "qa",
    "imdb",
    "e2e"
  ],
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
